{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "types": ["node", "jest"],
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
 "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/test/setup.ts" // Exclude your Vitest setup file specifically
  ]
}
